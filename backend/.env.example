SECRET_KEY=changeme-very-secret-key-at-least-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_synthesis
STORAGE_PATH=../storage
# Public sample page uses this dedicated demo account's real history
SAMPLE_USERNAME=sample
# Local dev + deployed frontend example (replace/add your real frontend origin)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://construction-garmin-anime-headquarters.trycloudflare.com,https://voxindex.vercel.app
FRONTEND_APP_URL=https://construction-garmin-anime-headquarters.trycloudflare.com
FRONTEND_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*(vercel\.app|trycloudflare\.com)$

# Password reset email delivery (local provider works immediately; switch to smtp for Gmail)
EMAIL_PROVIDER=local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=voxindexapp@gmail.com
SMTP_PASSWORD=changeme
SMTP_FROM_EMAIL=voxindexapp@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
PASSWORD_RESET_EXPIRE_MINUTES=60

# TTS provider: indextts2 | confucius4 | auto | stub
TTS_PROVIDER=indextts2

# Confucius4-TTS runtime settings (used when TTS_PROVIDER=confucius4)
CONFUCIUS4_REPO_PATH=../confucius4-tts
CONFUCIUS4_CONFIG_PATH=../confucius4-tts/config/inference_config.yaml
CONFUCIUS4_T2S_CHECKPOINT=
CONFUCIUS4_DEVICE=cuda

# IndexTTS2 runtime settings (used when TTS_PROVIDER=indextts2)
# If you vendored IndexTTS2 into this repo, place checkpoints under `index-tts/checkpoints`
# Example (relative to backend/): ../index-tts/checkpoints
INDEXTTS2_CONFIG_PATH=../index-tts/checkpoints/config.yaml
INDEXTTS2_MODEL_DIR=../index-tts/checkpoints
INDEXTTS2_USE_FP16=false
INDEXTTS2_USE_CUDA_KERNEL=false
INDEXTTS2_USE_DEEPSPEED=false
