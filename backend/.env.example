SECRET_KEY=changeme-very-secret-key-at-least-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql://postgres:password@localhost:5432/voice_synthesis
STORAGE_PATH=../storage
# Local dev + public frontend example (replace with your real deployed frontend URL)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# TTS provider: stub | indextts2
TTS_PROVIDER=stub

# IndexTTS2 runtime settings (used when TTS_PROVIDER=indextts2)
# If you vendored IndexTTS2 into this repo, place checkpoints under `index-tts/checkpoints`
# Example (relative to backend/): ../index-tts/checkpoints
INDEXTTS2_CONFIG_PATH=../index-tts/checkpoints/config.yaml
INDEXTTS2_MODEL_DIR=../index-tts/checkpoints
INDEXTTS2_USE_FP16=false
INDEXTTS2_USE_CUDA_KERNEL=false
INDEXTTS2_USE_DEEPSPEED=false
